# PostgreSQL connection string. Required.
# On Vercel / other serverless platforms, use Supabase's "Transaction
# pooler" string (port 6543), not the direct or session-pooler one —
# see the README's "Deploying to Vercel" section for why.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Long random string used to sign session cookies. Required.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Without it, the AI assistant returns a clear "not configured"
# message instead of a fake response — the rest of the app works normally.
OPENAI_API_KEY=
